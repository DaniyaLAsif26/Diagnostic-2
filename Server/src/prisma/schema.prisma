datasource db{
    provider = "postgresql"
}

generator client{
    provider = "prisma-client-js"
}

enum Category {
    LABORATORY
    RADIOLOGY
}

model Admin {
id String @id @default(uuid())
email String @db.VarChar(100) @unique
password String @db.VarChar(15)

createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @default(now()) @map("updated_at")

@@map("admins")
}

model User{
    id Int @id @default(autoincrement())
    name String @db.VarChar(50)
    phone String @db.VarChar(10) @unique
    email String @db.VarChar(60) @unique
    password String

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

    customPackages CustomPackage[]

    @@map("users")
}

enum CustomPackageStatus {
    PENDING
    COMPLETED
    CANCELLED
}

model CustomPackage {
    id Int @id @default(autoincrement())
    name String @db.VarChar(100)

    price Int
    couponCode String? @map("coupon_code")
    status CustomPackageStatus @default(PENDING)

    userId Int @map("user_id")
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    items CustomPackageItem[]

createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

@@index([userId])
    @@index([status])
    @@map("custom_packages")
}

model CustomPackageItem{

id Int @id @default(autoincrement())
price Int
testName String @db.VarChar(100) @map("test_name")

testId Int @map("test_id")
customPackageId Int @map("custom_package_id")

customPackage CustomPackage @relation(fields: [customPackageId], references: [id], onDelete: Cascade)

test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

@@unique([customPackageId, testId])
    @@index([testId])
    @@map("custom_package_items")
}

model Test {
    id Int @id @default(autoincrement())
    name String @db.VarChar(100) @unique
    price Int 
    offerPrice Int @default(0) @map("offer_price")
    isPopular Boolean @default(false) @map("is_popular")
    category Category
    relevance String[]
    preparation String?
    description String?

    packageItems PackageItem[]
    customPackageItems CustomPackageItem[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @default(now()) @map("updated_at")

@@index([name])
    @@map("tests")
}

model Package {
id Int @id @default(autoincrement())
name String @db.VarChar(150) @unique
price Int
offerPrice Int @default(0) @map("offer_price")
preparation String?
description String?
isPopular Boolean @default(false) @map("is_popular")
category Category
relevance String[]

items PackageItem[]

createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @default(now()) @map("updated_at")

    @@map("packages")
}

model PackageItem{
id Int @id @default(autoincrement())
packageId Int @map("package_id")
testId Int? @map("test_id")
testName String? @db.VarChar(150) @map("test_name")

pkg Package @relation (fields: [packageId] , references: [id], onDelete : Cascade)

test Test? @relation(fields: [testId] , references:[id], onDelete: Restrict)

createdAt DateTime @default(now()) @map("created_at")
updatedAt DateTime @default(now()) @map("updated_at")

@@unique([packageId,testId])
@@unique([packageId,testName])
@@index([testId])
    @@map("package_items")
}